{
  "name": "openklip",
  "version": "0.44.3",
  "private": true,
  "description": "Agent-native video editor: CLI edit loop, browser review, plain files on disk.",
  "homepage": "https://openklip.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openklip": "./src/cli.ts",
    "openklip-mcp": "./src/mcp-server.ts"
  },
  "scripts": {
    "acceptance-corpus": "bun run scripts/acceptance-corpus.ts",
    "acceptance-gate": "bun run scripts/acceptance-gate.ts",
    "agent-demo": "bun run scripts/agent-demo.ts",
    "agent-make-highlights": "bun run scripts/agent-make-highlights.ts",
    "agent-make-short": "bun run scripts/agent-make-short.ts",
    "agent-smoke-audit": "bun run scripts/agent-smoke-audit.ts",
    "analyze": "ANALYZE=true bun --bun next build --webpack",
    "build": "next build",
    "cam-devex-smoke": "bun run scripts/cam-devex-smoke.ts",
    "check": "ultracite check",
    "ci": "bun run scripts/local-ci.ts",
    "demo-gif": "bash scripts/record-demo-gif.sh",
    "desktop:prepare-bundle": "bun run scripts/prepare-desktop-bundle.ts",
    "dev": "bun --bun next dev -p 4399",
    "docs:gen": "fumadocs-mdx",
    "export": "bun run src/cli.ts export",
    "fix": "ultracite fix",
    "generate-multicam-fixture": "bun run scripts/generate-multicam-fixture.ts",
    "hooks:install": "bun run scripts/install-git-hooks.ts",
    "ingest": "bun run src/cli.ts ingest",
    "postinstall": "fumadocs-mdx && bun run hooks:install",
    "jscpd": "jscpd",
    "knip": "knip --production",
    "mcp": "bun run src/mcp-server.ts",
    "multicam-acceptance": "bun test --isolate tests/multicam-acceptance.test.ts",
    "release:desktop": "bun run scripts/release-desktop.ts",
    "serve": "bun run src/cli.ts serve",
    "start": "bun --bun next start -p 4399",
    "test": "bun test --isolate",
    "test:acceptance": "OPENKLIP_ACCEPTANCE=1 bun test --isolate tests/acceptance-gate.test.ts",
    "test:integration": "OPENKLIP_INTEGRATION=1 bun test --isolate tests/transcript-diff-browser.test.ts tests/json-graphic-browser.test.ts tests/golden-path-browser.test.ts tests/mobile-overlays-browser.test.ts tests/save-recovery-browser.test.ts tests/job-center-browser.test.ts",
    "typecheck": "fumadocs-mdx && tsc --noEmit"
  },
  "overrides": {
    "onnxruntime-web": "file:./vendor/onnxruntime-web-stub"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@huggingface/transformers": "4.2.0",
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@livekit/components-react": "^2.9.23",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@paper-design/shaders": "^0.0.78",
    "@pierre/diffs": "^1.3.4",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.46.0",
    "@types/mdx": "^2.0.14",
    "ai": "^7.0.55",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.1.2",
    "culori": "^4.0.2",
    "ffmpeg-static": "^5.3.0",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.0",
    "glimm": "0.3.0",
    "livekit-client": "^2.21.0",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "file:./vendor/onnxruntime-web-stub",
    "pino": "^10.3.1",
    "puppeteer-core": "^25.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@next/bundle-analyzer": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.2.0",
    "@types/culori": "^4.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.10.1"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "trustedDependencies": [
    "ffmpeg-static",
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ]
}
